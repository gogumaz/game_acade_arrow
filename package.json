{
  "name": "neon-grid-arcade",
  "private": true,
  "version": "0.1.0",
  "description": "NEON GRID - 8x20 Tetromino Arcade (game_acade_arrow)",
  "author": "NEON GRID Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win portable",
    "package:linux": "npm run build && electron-builder --linux tar.gz"
  },
  "build": {
    "appId": "com.neongrid.arcade",
    "productName": "NeonGridArcade",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "tar.gz",
      "category": "Game"
    }
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
